# Environment
ENVIRONMENT=development
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS - Comma-separated allowed origins
# For development: http://localhost:5173,http://127.0.0.1:5173
# For production: set to your actual frontend domain(s)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# Example Local format: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=mr_office_db

# Security & Authentication
# Generate a strong 64-character secret in production using: openssl rand -hex 32
JWT_SECRET=mr_office_super_secure_jwt_dev_secret_key_change_in_production_2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User Credentials (used by seed script if database is empty)
DEFAULT_ADMIN_EMAIL=admin@mroffice.in
DEFAULT_ADMIN_PASSWORD=Admin@MrOffice2025!
DEFAULT_ADMIN_NAME=Mr. Office Admin
